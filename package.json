{
  "name": "essence-ccg-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:admin": "npm run dev",
    "dev:cardforge": "npm run dev --workspace=@essence/cardforge",
    "build": "npm run build:admin && npm run build:cardforge",
    "build:admin": "vite build",
    "build:cardforge": "npm run build --workspace=@essence/cardforge",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js apps/*/dist packages/*/dist",
    "lint": "npm run lint:admin && npm run lint --workspace=@essence/cardforge",
    "lint:admin": "tsc --noEmit",
    "typecheck": "npm run lint",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
